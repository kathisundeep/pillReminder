{
  "name": "pillreminder",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "build:apk": "eas build -p android --profile preview",
    "test": "jest --selectProjects unit",
    "test:watch": "jest --selectProjects unit --watch",
    "test:coverage": "jest --selectProjects unit --coverage",
    "test:live": "jest --selectProjects live",
    "verify": "jest --selectProjects unit --coverage",
    "qr": "node scripts/make-qr.js",
    "release:apk": "node scripts/release-apk.js",
    "sql": "node scripts/build-sql.js",
    "fn:deploy": "npx -y supabase@latest functions deploy send-otp verify-otp create-account --project-ref accxqbtukprszgwroorq",
    "fn:check": "node scripts/check-functions.js",
    "fn:login": "npx -y supabase@latest login",
    "fn:logs": "echo \"Function logs are dashboard-only (the CLI has no logs command):\" && echo \"  https://supabase.com/dashboard/project/accxqbtukprszgwroorq/functions/send-otp/logs\""
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@supabase/supabase-js": "^2.110.0",
    "expo": "~51.0.28",
    "expo-av": "~14.0.7",
    "expo-background-fetch": "~12.0.1",
    "expo-constants": "~16.0.2",
    "expo-device": "~6.0.2",
    "expo-image-manipulator": "~12.0.5",
    "expo-image-picker": "~15.1.0",
    "expo-keep-awake": "~13.0.2",
    "expo-linear-gradient": "~13.0.2",
    "expo-notifications": "~0.28.16",
    "expo-status-bar": "~1.12.1",
    "expo-task-manager": "~11.8.2",
    "expo-updates": "~0.25.28",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-url-polyfill": "^3.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@testing-library/react-native": "^12.9.0",
    "jest": "^29.7.0",
    "jest-expo": "~51.0.4",
    "qrcode": "^1.5.4",
    "react-test-renderer": "^18.2.0"
  },
  "private": true
}
